{
  "name": "@jielga/tmdatagrid",
  "version": "0.0.1",
  "description": "A React data grid built on TanStack Table v9 and Mantine — always virtualized, with resizable, sortable, filterable, hideable and pinnable columns.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jielga/TMDataGrid.git"
  },
  "homepage": "https://github.com/Jielga/TMDataGrid#readme",
  "bugs": {
    "url": "https://github.com/Jielga/TMDataGrid/issues"
  },
  "keywords": [
    "react",
    "datagrid",
    "data-grid",
    "table",
    "mantine",
    "tanstack-table",
    "virtualized"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/tmdatagrid"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && rollup -c rollup.dts.config.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepublishOnly": "npm run lint && npm run build:lib"
  },
  "peerDependencies": {
    "@mantine/core": "^9.4.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-table": "^9.0.0-beta.21",
    "@tanstack/react-virtual": "^3.14.4",
    "@tanstack/store": "^0.11.0",
    "@tanstack/table-core": "^9.0.0-beta.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@mantine/core": "^9.4.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-table": "^9.0.0-beta.21",
    "@tanstack/react-virtual": "^3.14.4",
    "@tanstack/store": "^0.11.0",
    "@tanstack/table-core": "^9.0.0-beta.21",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.69.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
