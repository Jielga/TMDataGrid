      "@mantine/hooks": "^9.4.2",
      "@playwright/test": "^1.63.0",
      "@rolldown/plugin-babel": "^0.2.4",
      "@tabler/icons-react": "^3.46.0",
      "@tanstack/intent": "0.3.6",
      "@tanstack/match-sorter-utils": "^8.19.4",
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-store": "^0.11.2",
      "@tanstack/react-table": "^9.2.4",
      "@tanstack/react-virtual": "^3.14.14",
      "@tanstack/store": "^0.11.2",
      "@tanstack/table-core": "^9.2.4",
      "@testing-library/jest-dom": "^7.0.0",
      "@testing-library/react": "^16.3.2",
      "@testing-library/user-event": "^14.6.7",
      "@types/babel__core": "^7.20.5",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "@vitejs/plugin-react": "^6.0.5",
      "babel-plugin-react-compiler": "^1.0.0",
      "exceljs": "^4.4.0",
      "jsdom": "^29.1.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "typescript": "~7.0.2",
      "vite": "^8.1.6",
      "vitest": "^4.1.10",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "build": "bun run build:lib && bun run build:docs",
    "build:lib": "bun run --cwd packages/tmdatagrid build && bun run --cwd packages/tmdatagrid-xlsx build",
    "build:docs": "bun run --cwd apps/docs build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "check:skills": "node scripts/intent.mjs validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-skill-version.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@manypkg/get-packages": "^3.1.0",
    "@playwright/test": "catalog:",
    "@tanstack/intent": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "^24.13.6",
    "husky": "^9.1.7",
    "jsdom": "catalog:",
    "oxlint": "^1.69.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
