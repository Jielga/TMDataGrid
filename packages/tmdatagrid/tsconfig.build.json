{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tmdatagrid.build.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "src",
    // Per-file declarations are an intermediate artefact: rolldown-plugin-dts
    // flattens them into a single dist/index.d.ts. This must not live under
    // node_modules - the plugin treats anything resolving in there as
    // external and would re-export the files instead of inlining them.
    "outDir": ".types-tmp",
    "types": ["vite/client"]
  },
  "include": ["src"],
  // Tests live beside the code they cover but are not part of the package, and
  // emitting declarations for them would drag the test types into the rollup.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
