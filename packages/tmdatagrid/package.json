{
  "name": "@jielga/tmdatagrid",
  "version": "2.0.0-beta.14",
  "description": "A React data grid built on TanStack Table v9 and Mantine - always virtualized, with resizable, reorderable, sortable, filterable, hideable and pinnable columns.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jielga/TMDataGrid.git",
    "directory": "packages/tmdatagrid"
  },
  "homepage": "https://jielga.github.io/TMDataGrid/",
  "bugs": {
    "url": "https://github.com/Jielga/TMDataGrid/issues"
  },
  "keywords": [
    "react",
    "datagrid",
    "data-grid",
    "table",
    "mantine",
    "tanstack-table",
    "virtualized",
    "tanstack-intent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "intent": {
    "docs": "docs/"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "docs",
    "skills",
    "!skills/_artifacts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && rolldown -c rolldown.dts.config.mjs",
    "test": "vitest run",
    "prepublishOnly": "oxlint && bun run build"
  },
  "peerDependencies": {
    "@mantine/core": "^9.4.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.4",
    "@tanstack/store": "^0.11.0",
    "@tanstack/table-core": "^9.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@mantine/core": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tabler/icons-react": "catalog:",
    "@tanstack/intent": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-store": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@tanstack/store": "catalog:",
    "@tanstack/table-core": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rolldown": "~1.1.5",
    "rolldown-plugin-dts": "^0.27.14",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
