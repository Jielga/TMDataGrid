{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "src/tmdatagrid",
    // Per-file declarations are an intermediate artefact: rollup-plugin-dts
    // flattens them into a single dist/index.d.ts. This must not live under
    // node_modules — rollup-plugin-dts treats anything resolving in there as
    // external and would re-export the files instead of inlining them.
    "outDir": ".types-tmp"
  },
  "include": ["src/tmdatagrid"],
  // Tests live beside the code they cover but are not part of the package, and
  // emitting declarations for them would drag the test types into the rollup.
  "exclude": ["src/tmdatagrid/**/*.test.ts", "src/tmdatagrid/**/*.test.tsx"]
}
